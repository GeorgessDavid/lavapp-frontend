# Copiar como .env.local (ignorado por git).

# false para usar la API real; cualquier otro valor (o ausente) = modo demo con datos mock.
NEXT_PUBLIC_USE_MOCK=false
# URL base del back-end Spring Boot.
NEXT_PUBLIC_API_URL=http://localhost:8080

# Producción (Vercel): el front llama a /api y Next lo reenvía al back-end (next.config.ts),
# para que la cookie de sesión sea del mismo sitio que el front.
#   NEXT_PUBLIC_API_URL=/api
#   API_ORIGIN=https://54-198-115-60.sslip.io

